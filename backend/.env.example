# Backend Configuration

# Server port
PORT=5000

# MongoDB connection URI
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/civic-portal?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017/civic-portal
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/civic-portal?retryWrites=true&w=majority

# JWT secret key (generate a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# JWT expiration time
JWT_EXPIRES_IN=7d

# Frontend origin for CORS (change if frontend is on different port)
CLIENT_ORIGIN=http://localhost:5173
